 *
from
dept;
insert into dept
values
(1,'hr',10),
(2,'sales',20),
(3,'analytics',30),
(4,'it',25),
(5,'management',15);
select 
* 
from 
employee
where dept in(select
                    distinct name
				from 
				dept)
select
max(salary)
from 
employee

select
top(1)*
from employee
where salary<(select
max(salary)
from 
employee)
order by salary desc;
select 
top(1)* 
from employee
where salary<(select
top(1)salary
from employee
where salary<(select
max(salary)
from 
employee)
order by salary desc)
order by salary desc;

select 
min(salary)
from 
employee;

select 
  top(1)*
from employee
where salary>(select 
min(salary)
from 
employee)
order by salary;


