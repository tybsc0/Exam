with main_data as(
SELECT
	ProductKey,
	SalesAmount,
	TRY_CAST(REPLACE(REPLACE(SalesAmount, N'ريال', ''), ',','') AS FLOAT) as Sales
FROM
	FactInternetSales
),

avg_sales as (
select
	AVG(sales) as AVG_VAL
from
main_data
),



with main_data as(
SELECT 
	ProductKey,
    SalesAmount,
    TRY_CAST(REPLACE(REPLACE(SalesAmount, N'ريال', ''), ',', '') AS FLOAT) as Sales
FROM 
    FactInternetSales
),

avg_sales as (
select
	AVG(sales) AS AVG_VAL
from
main_data
),

PRODUCTS AS(
SELECT
	DISTINCT ProductKey
FROM
main_data
WHERE Sales > (SELECT AVG_VAL FROM avg_sales)
)

SELECT
	EnglishProductName
FROM
DimProduct
WHERE ProductKey IN (SELECT ProductKey FROM PRODUCTS)






